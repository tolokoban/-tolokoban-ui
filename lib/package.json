{
    "name": "@tolokoban/ui",
    "version": "0.25.5",
    "private": false,
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "generate": "node scripts/prebuild/prebuild.mjs",
        "prepack": "npm run build",
        "prebuild": "rm -rf dist/* && npm run generate",
        "doc": "typedoc --out ../doc/public/api",
        "build": "build-typescript-library .",
        "lint": "eslint 'src/**/*.ts'",
        "start": "build-typescript-library --watch -runBefore generate .",
        "test": "jest",
        "test:watch": "jest --watch",
        "prepub": "npm run build",
        "pub": "npm publish --access public",
        "prestart": "npm run generate"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/compat": "^2.0.1",
        "@types/node": "^25.0.10",
        "@types/react": "^19.2.10",
        "acorn": "^8.15.0",
        "babel-loader": "^9.2.1",
        "build-typescript-library": "^0.12.1",
        "chalk": "^5.6.2",
        "chokidar": "^5.0.0",
        "ts-loader": "^9.5.4",
        "ts-patch": "^3.3.0",
        "typedoc": "^0.28.19",
        "typescript": "^5.9.3",
        "typescript-plugin-css-modules": "^5.2.0",
        "typescript-transform-paths": "^3.5.6"
    },
    "dependencies": {
        "json5": "^2.2.3",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "react": "^19.2.7"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "description": "React components with theme",
    "homepage": "https://tolokoban.github.io/ui"
}