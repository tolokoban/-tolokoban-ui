{
    "name": "@tolokoban/ui",
    "version": "0.25.7",
    "private": true,
    "sideEffects": [
        "*.css"
    ],
    "homepage": "https://tolokoban.github.io/ui",
    "dependencies": {
        "@tolokoban/ui": "file:../",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.1"
    },
    "scripts": {
        "pregenerate": "tsc -p scripts/tsconfig.json",
        "generate": "node scripts/dist/prebuild.js && build-react-routes src/app",
        "prestart": "npm run generate",
        "start": "rspack serve --mode=development",
        "build": "rspack build --mode=production",
        "cc": "clear && rspack build --mode=development --stats-error-details",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d build/",
        "lint": "eslint -c .eslintrc.yml 'src/**/*.ts' 'src/**/*.tsx'",
        "format": "prettier --write ./src/",
        "test": "jest"
    },
    "eslintConfig": {
        "extends": "react-app"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@rspack/cli": "^1.7.12",
        "@rspack/core": "^1.7.12",
        "@types/jest": "^30.0.0",
        "@types/mdx": "^2.0.14",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-syntax-highlighter": "^15.5.13",
        "babel-jest": "^30.2.0",
        "build-react-routes": "^0.11.1",
        "css-loader": "^6.11.0",
        "gh-pages": "^6.3.0",
        "jest": "^30.4.2",
        "markdown-to-jsx": "^9.8.2",
        "style-loader": "^3.3.4",
        "ts-jest": "^29.4.5",
        "ts-morph": "^27.0.2",
        "ts-node": "^10.9.2",
        "tslint": "^6.1.3",
        "typescript": "^5.9.3"
    },
    "port": 61749,
    "description": "React components with theme"
}